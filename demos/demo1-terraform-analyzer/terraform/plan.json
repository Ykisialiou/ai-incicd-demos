{
  "format_version": "1.2",
  "terraform_version": "1.14.4",
  "resource_changes": [
    {
      "address": "aws_db_instance.production_db",
      "type": "aws_db_instance",
      "name": "production_db",
      "change": {
        "actions": ["delete", "create"],
        "before": {
          "identifier": "production-customer-db-v1",
          "allocated_storage": 20,
          "engine": "postgres",
          "instance_class": "db.t3.medium"
        },
        "after": {
          "identifier": "production-customer-db-v2",
          "allocated_storage": 20,
          "engine": "postgres",
          "instance_class": "db.t3.medium",
          "skip_final_snapshot": true
        }
      }
    },
    {
      "address": "aws_security_group.app_ingress",
      "type": "aws_security_group",
      "name": "app_ingress",
      "change": {
        "actions": ["update"],
        "before": {
          "name": "app-production-ingress",
          "ingress": [
            {
              "cidr_blocks": ["0.0.0.0/0"],
              "from_port": 443,
              "to_port": 443,
              "protocol": "tcp"
            }
          ]
        },
        "after": {
          "name": "app-production-ingress",
          "ingress": [
            {
              "cidr_blocks": ["10.0.0.0/16"],
              "from_port": 443,
              "to_port": 443,
              "protocol": "tcp"
            }
          ]
        }
      }
    },
    {
      "address": "aws_cloudfront_distribution.cdn",
      "type": "aws_cloudfront_distribution",
      "name": "cdn",
      "change": {
        "actions": ["update"],
        "before": {
          "aliases": []
        },
        "after": {
          "aliases": ["api.company.com"],
          "enabled": true
        }
      }
    },
    {
      "address": "aws_route53_record.api_dns",
      "type": "aws_route53_record",
      "name": "api_dns",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "api.company.com",
          "type": "A",
          "zone_id": "Z123456789ABC"
        }
      }
    },
    {
      "address": "aws_s3_bucket.data_lake",
      "type": "aws_s3_bucket",
      "name": "data_lake",
      "change": {
        "actions": ["update"],
        "before": {
          "bucket": "company-production-data-lake-raw",
          "tags": {
            "Environment": "production"
          }
        },
        "after": {
          "bucket": "company-production-data-lake-raw",
          "tags": {
            "Environment": "production",
            "CostCenter": "Data-Analytics-402",
            "Owner": "DataOps-Team",
            "ComplianceScope": "SOC2-Type2"
          }
        }
      }
    }
  ]
}
