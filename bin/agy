#!/usr/bin/env bash
# ==============================================================================
# agy - Antigravity CI/CD Bridge Runner
#
# Bridges CI/CD data and prompt templates directly to the Antigravity engine (agy)
# ==============================================================================

set -euo pipefail

PYTHON_BIN="$(command -v python3 || echo "python")"

exec "$PYTHON_BIN" - "$@" << 'PYEOF'
import os
import sys
import json
import shutil
import argparse
import subprocess
import urllib.request
import urllib.error

DEFAULT_MODEL = os.getenv("AGY_MODEL", os.getenv("GEMINI_MODEL", "gemini-2.5-flash"))

def get_api_key():
    return os.getenv("AGY_API_KEY") or os.getenv("GEMINI_API_KEY") or os.getenv("GOOGLE_API_KEY")

def call_native_agy_binary(system_instruction: str, user_content: str, model: str) -> str:
    """Call installed official agy binary in print mode if available."""
    agy_path = shutil.which("agy")
    # Make sure we are not calling this script itself
    if agy_path and not os.path.samefile(agy_path, sys.argv[0]):
        full_prompt = f"System Instructions:\n{system_instruction}\n\nUser Task & Data:\n{user_content}"
        try:
            cmd = [agy_path, "--print", "--dangerously-skip-permissions", full_prompt]
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
            if result.returncode == 0 and result.stdout.strip():
                return result.stdout.strip()
        except Exception as e:
            sys.stderr.write(f"Notice: agy binary invocation fallback to direct API: {str(e)}\n")
    return None

def call_gemini_api(api_key: str, model: str, system_instruction: str, user_content: str) -> str:
    endpoint = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
    payload = {
        "contents": [{"role": "user", "parts": [{"text": user_content}]}]
    }
    if system_instruction:
        payload["system_instruction"] = {"parts": [{"text": system_instruction}]}

    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(endpoint, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as response:
            result = json.loads(response.read().decode("utf-8"))
            candidates = result.get("candidates", [])
            if not candidates:
                return "Error: No response generated by Antigravity engine."
            parts = candidates[0].get("content", {}).get("parts", [])
            return "".join([p.get("text", "") for p in parts])
    except urllib.error.HTTPError as e:
        error_msg = e.read().decode("utf-8")
        sys.stderr.write(f"Antigravity API HTTP Error {e.code}: {error_msg}\n")
        sys.exit(1)
    except Exception as e:
        sys.stderr.write(f"Connection error to Antigravity API: {str(e)}\n")
        sys.exit(1)

def offline_simulation(system_instruction: str, user_content: str) -> str:
    sys.stderr.write("\n[NOTE] Running agy in Demo Simulation Mode.\n\n")
    content_lower = user_content.lower() + (system_instruction.lower() if system_instruction else "")
    
    if "cab" in content_lower or "change management" in content_lower or "email" in content_lower:
        return """Subject: [RFC - Change Request] Production Infrastructure Release: Customer DB & Analytics (2026-08-31) - Risk Level: 🔴 CRITICAL

Hi Change Advisory Board (CAB) & SRE Team,

Please review the automated Change Request generated for the upcoming infrastructure release.

================================================================================
📋 1. CHANGE OVERVIEW & SCHEDULE
================================================================================
• Target Environment  : Production (AWS us-east-1)
• Planned Window      : Tomorrow, 2026-08-31 03:00 UTC (Low traffic window)
• Expected Duration   : 15 minutes
• Expected Downtime   : ⚠️ ~10 minutes (Database Replacement Detected!)
• Initiated By        : Pipeline / PR #1 (Author: DevOps Team)

================================================================================
🔍 2. EXECUTIVE SUMMARY OF PLANNED CHANGES
================================================================================
• [CRITICAL] Modifying production database identifier (Forces database DROP & RECREATE).
• [HIGH RISK] Creating security group rule exposing SSH port 22 to 0.0.0.0/0.
• [LOW RISK] Creating new S3 bucket `company-production-data-lake-raw`.

================================================================================
⚖️ 3. RISK ASSESSMENT & BLAST RADIUS
================================================================================
• Overall Risk Rating : 🔴 CRITICAL RISK
• Blast Radius Score  : 9.5 / 10
• Destruction Alert   : `aws_db_instance.production_db` will be destroyed!
• Recommendation      : DO NOT APPROVE in current state until `lifecycle.prevent_destroy` is added.

================================================================================
🔄 4. ROLLBACK & CONTINGENCY PLAN
================================================================================
• Rollback Trigger    : If DB connectivity fails or data loss detected.
• Rollback Procedure  : Restore pre-release snapshot `rds:production-customer-db-pre-release` and revert commit.
• Estimated Recovery  : 12 minutes.

================================================================================
🧪 5. POST-DEPLOYMENT VERIFICATION STEPS
================================================================================
1. Verify PostgreSQL replication and client connections.
2. Execute automated API test suite (`pytest tests/smoke`).
3. Audit security group ingress rules in AWS console.

---
Generated automatically by Antigravity CI/CD Agent (agy)."""
    elif "terraform" in content_lower or "resource_changes" in content_lower or "aws_db_instance" in content_lower:
        return """# 🛑 Terraform SRE Gate: BLOCKED (Action Required)

> **Blast Radius Score**: **9.5 / 10 (CRITICAL)**  
> **Change Summary**: `+1` to add, `~3` to change, `💥1` to replace, `-0` to destroy.  
> **Notion RFC Page**: [📄 View CAB RFC Document](demos/demo1-terraform-analyzer/change_requests/RFC-20260831-01-customer-db.md)

---

### 📋 Engineering Change Matrix (Fast-Scan for Team Leads & Release Managers)

| Resource | Action | Static Linter Verdict | AI Agent Contextual Verdict | Reason & Production Impact |
| :--- | :--- | :--- | :--- | :--- |
| `aws_db_instance.production_db` | 💥 **REPLACE** | 🟡 `Change` | 🔴 **CRITICAL (9.5/10)** | Renaming DB identifier forces **DROP & RECREATE** of production DB cluster! |
| `aws_route53_record.api_dns` | ✨ **CREATE** | 🟢 `Low (Add)` | 🟠 **HIGH (7.5/10)** | ⚠️ **Policy & Scope Hazard**: Pointing `api.company.com` directly to CloudFront bypasses API Gateway & WAF. Also unrelated to PR title! |
| `aws_cloudfront_distribution.cdn` | 🔄 **UPDATE** | 🟡 `Change` | 🟡 **MEDIUM (5.0/10)** | Added domain alias `api.company.com`. Edge distribution sync takes ~5-15 mins. |
| `aws_security_group.app_ingress` | 🔄 **UPDATE** | 🟢 `Pass` | 🟡 **WARN (4.0/10)** | Ingress tightened (`0.0.0.0/0` ➔ `10.0.0.0/16:443`). Verify no external traffic is dropped! |
| `aws_s3_bucket.data_lake` | 🔄 **UPDATE** | 🟢 `Pass` | 🟢 **SAFE (1.0/10)** | In-place metadata tags added (`CostCenter`, `Owner`, `ComplianceScope`). Zero downtime. |

---

### 🧠 Why Static Linting Fails Here (The Agentic Advantage)
> **Static Linters (TFLint/Checkov)** see `aws_route53_record.api_dns` as a harmless additive resource (`🟢 LOW`).  
> **The AI Agent** understands **Architecture Policy & Business Context**:
> 1. `api.company.com` is your core production API domain — pointing it directly to CloudFront bypasses your API Gateway and DDoS WAF layer.
> 2. **PR Scope Creep**: The PR claims to be a *"customer DB update"*, but silently sneaks in critical DNS traffic redirection.

---

### 🚨 Critical Alerts & Hazards
- 💥 **DESTRUCTIVE REPLACEMENT DETECTED**: `aws_db_instance.production_db` will be **DESTROYED AND RECREATED**. Severe data loss and outage risk!
- 🌐 **DNS TRAFFIC REDIRECTION**: `aws_route53_record.api_dns` reroutes production `api.company.com` traffic directly to CloudFront.
- ⏱️ **EDGE PROPAGATION LATENCY**: `aws_cloudfront_distribution.cdn` requires 5-15 mins for global edge sync and ACM certificate validation.
- 🔒 **SECURITY GROUP TIGHTENING**: `aws_security_group.app_ingress` restricts traffic to `10.0.0.0/16`. Ensure all client services are inside VPC.

---

### 🛡️ Recommended HCL Remediation Patch

```hcl
# Fix: Prevent accidental DB destruction
resource "aws_db_instance" "production_db" {
  lifecycle {
    prevent_destroy = true
  }
}
```

---

**Gate Verdict**: ❌ **🔴 BLOCKED (Prevent DB destruction before merge)**
"""
    elif "trivy" in content_lower or "vulnerabilit" in content_lower or "cve-" in content_lower:
        return """# 🛡️ Trivy Security Triage Report

### 🎯 Triage Summary
- **Total Scanned Items**: 18 findings
- **Filtered Noise (Low risk / unreachable)**: 16 items
- **Actionable High/Critical Threats**: **2 Findings**
- **Security Gate Decision**: ⚠️ **WARNING (Actionable Fixes Available)**

---

### 🔍 Actionable Vulnerability Triage

| Package | CVE ID | Severity | In-The-Wild Exploit? | Fix Available? | Recommended Action |
| :--- | :--- | :--- | :--- | :--- | :--- |
| `libssl3` | `CVE-2023-0286` | 🔴 **CRITICAL** | Yes (Public PoC) | ✅ `3.0.8-r0` | Upgrade base image to `alpine:3.18+` |
| `express` | `CVE-2022-24999` | 🟠 **HIGH** | Low | ✅ `^4.18.2` | Bump package in `package.json` |

---

### 🚀 Instant Remediation Patch

Update `Dockerfile`:
```diff
- FROM node:16.14-alpine
+ FROM node:20.11-alpine
```

Update `package.json`:
```diff
- "express": "4.16.0",
+ "express": "^4.18.2",
```

**Next Steps**: Applying the base image bump automatically resolves 14 out of 16 base OS vulnerabilities.
"""
    elif "build" in content_lower or "pipeline" in content_lower or "error" in content_lower or "gyp" in content_lower:
        return """# 🩺 CI/CD Build Doctor: Root Cause Analysis

### 🎯 Diagnosis Summary
- **Failure Type**: Native Dependency Compilation Failure (`node-gyp`)
- **Failing Step**: `npm install --frozen-lockfile` (Line 142)
- **Primary Root Cause**: Missing Python 3 build tools in slim alpine container required to compile `better-sqlite3`.

---

### 🔍 Log Forensics
```text
> better-sqlite3@7.5.0 install /app/node_modules/better-sqlite3
> node-gyp rebuild
gyp ERR! find Python
gyp ERR! find Python - "python3" can't be in PATH
gyp ERR! stack Error: Could not find any Python installation to use
```

---

### 💡 Quick Fix Recommendation

Add `python3`, `make`, and `g++` before running `npm install` in your pipeline / Dockerfile:

```dockerfile
# Add build dependencies for native node-gyp modules
RUN apk add --no-cache python3 make g++

RUN npm ci
```

Or run locally:
```bash
apk add --no-cache python3 make g++ && npm install
```
"""
    else:
        return f"### Antigravity Agent Analysis\n\nProcessed {len(user_content)} bytes of input data against prompt instructions.\n\nInput summary: Received task input. To run live API calls, export `AGY_API_KEY`."

def main():
    parser = argparse.ArgumentParser(description="agy - Antigravity CI/CD Bridge Runner")
    parser.add_argument("--prompt", "-p", help="User prompt or task instructions", default="")
    parser.add_argument("--system-prompt", "-s", help="Path to system prompt file or raw text", default="")
    parser.add_argument("--file", "-f", help="Input file to read and append to user prompt", default="")
    parser.add_argument("--model", "-m", help=f"Model name (default: {DEFAULT_MODEL})", default=DEFAULT_MODEL)
    parser.add_argument("--output", "-o", help="Write output to specified file instead of stdout", default="")
    parser.add_argument("--offline", action="store_true", help="Force offline demo simulation mode")
    
    args = parser.parse_args()

    system_instruction = ""
    if args.system_prompt:
        if os.path.exists(args.system_prompt):
            with open(args.system_prompt, "r", encoding="utf-8") as f:
                system_instruction = f.read()
        else:
            system_instruction = args.system_prompt

    content_parts = []
    if args.file and os.path.exists(args.file):
        with open(args.file, "r", encoding="utf-8") as f:
            content_parts.append(f.read())
            
    if not sys.stdin.isatty():
        stdin_content = sys.stdin.read().strip()
        if stdin_content:
            content_parts.append(stdin_content)
            
    if args.prompt:
        content_parts.append(args.prompt)

    user_content = "\n\n".join(content_parts).strip()
    if not user_content:
        sys.stderr.write("Error: No input provided. Supply text via --prompt, --file, or stdin.\n")
        sys.exit(1)

    api_key = get_api_key()
    response_text = None
    
    # 1. Try native agy binary if live key available
    if api_key and not args.offline:
        response_text = call_native_agy_binary(system_instruction, user_content, args.model)
        if not response_text:
            response_text = call_gemini_api(api_key, args.model, system_instruction, user_content)
    
    # 2. Fallback to simulation
    if not response_text:
        response_text = offline_simulation(system_instruction, user_content)

    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(response_text)
        print(f"Output saved to {args.output}")
    else:
        print(response_text)

if __name__ == "__main__":
    main()
PYEOF
